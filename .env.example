# Synapse environment — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   # Open .env and set NEO4J_PASSWORD (required).
#   docker compose up -d
#
# All values are read by synapse/config.py via pydantic-settings.
# docker-compose.yml overrides NEO4J_URI and REDIS_URL for the compose network;
# the values below are the host-side defaults (pytest, MCP server on the host).

# ---------------------------------------------------------------------------
# Neo4j  (Graphiti graph backend)
# Host port 7688 -> container 7687 (Bolt); 7475 -> 7474 (Browser)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_HTTP=http://127.0.0.1:7475
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_before_starting   # REQUIRED -- set a strong password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Redis  (Celery broker + brief cache)
# Host port 6382 -> container 6379
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6382/0

# ---------------------------------------------------------------------------
# Synapse API
# ---------------------------------------------------------------------------
SYNAPSE_API_URL=http://localhost:8848
SYNAPSE_API_PORT=8848

# Optional API key -- leave blank to disable auth (dev default).
# When set, all API routes require: X-Synapse-Key: <value>
API_KEY=

# ---------------------------------------------------------------------------
# LLM -- extraction and triage
# ---------------------------------------------------------------------------
# Required for cloud or hybrid extraction mode.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Extraction routing:
#   cloud  -- Claude Sonnet 4.6 (highest quality, costs tokens)
#   local  -- gemma3:12b via Ollama ($0; ~86%/~64% of Sonnet entity/edge quality)
#   hybrid -- local first, Sonnet fallback on parse failure (recommended, compose default)
EXTRACTION_MODE=hybrid

# Model names -- change only if you have validated the alternative
EXTRACTION_MODEL=claude-sonnet-4-6
TRIAGE_MODEL=claude-haiku-4-5
LOCAL_EXTRACTION_MODEL=gemma3:12b

# ---------------------------------------------------------------------------
# Ollama  (local embedder + local extraction model)
# Ollama must be running on the host with BGE-M3 pulled:
#   ollama pull bge-m3
# The dockerized API reaches it via host.docker.internal (overridden in compose).
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ---------------------------------------------------------------------------
# Session-lesson auto-capture
# PreCompact/SessionEnd hooks feed transcripts to a Haiku judge.
# Confidence >= CAPTURE_AUTOSTORE_THRESHOLD -> auto-stored; rest go to review queue.
# ---------------------------------------------------------------------------
CAPTURE_ENABLED=true
CAPTURE_AUTOSTORE_THRESHOLD=0.8
CAPTURE_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Write-pipeline thresholds
# ---------------------------------------------------------------------------
DEDUP_THRESHOLD=0.9       # cosine sim >= this => duplicate, skip re-store
RELATE_FLOOR=0.75         # [floor, dedup) => adjudicate vs nearest node

# ---------------------------------------------------------------------------
# Curation thresholds  (background maintenance tasks)
# ---------------------------------------------------------------------------
CURATION_DEDUP_THRESHOLD=0.97   # >= => merge candidate surfaced in Curate panel
CURATION_REVIEW_FLOOR=0.90      # [floor, dedup) => "possibly related, human glance"
CURATION_PAIR_LIMIT=500         # hard cap on the O(n^2) pair scan

# ---------------------------------------------------------------------------
# Graphiti concurrency
# ---------------------------------------------------------------------------
GRAPHITI_MAX_COROUTINES=5

# ---------------------------------------------------------------------------
# Filesystem -- connected projects
# Root under which all wired projects live.
# The dockerized API overrides this to /projects (the mounted host dir).
# SYNAPSE_HOST_DIR is written verbatim into wiring files so Claude Code on the
# host invokes the right venv python; keep it as a host path.
# ---------------------------------------------------------------------------
SYNAPSE_PROJECTS_ROOT=/your/projects/root
SYNAPSE_HOST_DIR=/your/path/to/synapse
