{
  "_comment": "Copy this into each connected project's .mcp.json. Set SYNAPSE_PROJECT_ID to that project's id (see projects.example.json). The server reads Neo4j/Ollama/Anthropic config from Synapse's own .env via an absolute path, so no creds are needed here.",
  "mcpServers": {
    "synapse": {
      "command": "/path/to/dev/projects/synapse/.venv/Scripts/python.exe",
      "args": ["-m", "synapse.mcp.server"],
      "env": {
        "SYNAPSE_PROJECT_ID": "acme-store",
        "PYTHONPATH": "/path/to/dev/projects/synapse"
      }
    }
  }
}
